# Optional overrides for docker compose. Copy to `.env` to customize; the file is
# git-ignored. Defaults target the bundled MongoDB service for local use.

# Runtime environment: development enables API docs at /docs; production disables them.
# APP_ENV=development

# Managed database override (for example MongoDB Atlas). When set, the bundled
# mongo service is unused. Credential-bearing; never commit a real value.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Target database name.
# MONGODB_DB_NAME=microservice
