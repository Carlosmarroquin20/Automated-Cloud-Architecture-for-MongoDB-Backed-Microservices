# Template of required environment variables. Real values are injected at runtime
# through environment variables or Kubernetes Secrets and are never committed.

# Runtime environment selector: development | staging | production
APP_ENV=development

# Structured logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Service listen port
APP_PORT=8000

# MongoDB Atlas connection string (TLS-enabled SRV URI). Credential-bearing.
# Format: mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=

# Target database name
MONGODB_DB_NAME=microservice

# Connection timeouts in milliseconds
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=10000

# Connection pool bounds
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0

# Startup connectivity warm-up and retry policy
MONGODB_PING_ON_STARTUP=true
MONGODB_CONNECT_MAX_RETRIES=5
MONGODB_CONNECT_RETRY_BASE_DELAY_SECONDS=0.5

# Comma-separated list of permitted CORS origins. Empty disables cross-origin.
CORS_ALLOW_ORIGINS=
