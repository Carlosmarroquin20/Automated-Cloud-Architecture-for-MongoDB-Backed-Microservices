# Optional build-time overrides consumed by Vite. When unset, the client uses
# same-origin defaults that match the production reverse-proxy topology, so no
# backend host is embedded in the shipped assets.

# API base path or absolute URL. Defaults to '/api/v1'.
VITE_API_BASE_URL=

# Readiness probe path or absolute URL. Defaults to '/health/ready'.
VITE_HEALTH_URL=
