{
  "name": "mongodb-microservice-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight static client for the MongoDB-backed microservice API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.8.9",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
